# ──────────────────────────────────────────────────────────────────────────
# NutriGuide Pro — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ──────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API with cookies.
# Include every frontend origin (local + production). No trailing slashes.
CLIENT_URL=http://localhost:3000

# --- Database ---
# MongoDB Atlas connection string (Database Access user, NOT your Atlas account login).
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/nutriguide?retryWrites=true&w=majority

# --- Auth / JWT ---
# Long, random, unique per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_value

# --- Email (OTP delivery via Resend SMTP) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a domain you've verified in Resend, or their sandbox sender
# (onboarding@resend.dev) for testing.
EMAIL_FROM="NutriGuide Pro <onboarding@resend.dev>"

# --- Google OAuth 2.0 ---
# From Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Must exactly match an "Authorized redirect URI" configured on the OAuth client
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Optional: AI food identifier on Calorie Calculator ---
ANTHROPIC_API_KEY=
